# Built sidecar binaries land here from CI per (os, arch). Committed in
# release builds, ignored in source tree so local cargo builds do not
# pollute git status.
/sidecar/

# Rust build artefacts
/sidecar-src/target/

# JS build tooling deps (esbuild).
/node_modules/

# Built bundle — generated from src/ by `node build.mjs`. NOT committed: CI
# (release.yml) builds it into the release .zip that users install. For local
# dev (dev-link) run `npm run build` once, or `npm run watch` while editing.
/extension.js

# Release zip
dist/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json
